# ==========================================
# Trace AI CS — 账号级凭证（仅最敏感信息）
# ==========================================
# 这些是火山引擎账号凭证，所有场景通用。
# 场景级别的配置（ASR/TTS/LLM）请在各场景的 .json 中配置。
#
# 使用方式:
#   1. cp .env.example .env
#   2. 填入你的值
#   3. 场景 JSON 中用 ${VAR_NAME} 引用
# ==========================================

# 火山引擎账号凭证（必需）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_KEY=
