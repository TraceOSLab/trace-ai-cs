# ==========================================
# Trace AI CS — 账号级凭证
# ==========================================
# 使用方式:
#   1. cp .env.example .env
#   2. 填入你的值
#   3. 场景 JSON 中用 ${VAR_NAME} 引用
# ==========================================

# 火山引擎账号凭证（必需）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_KEY=

# CustomLLM 回调地址（必需，火山引擎会回调这个地址来获取 LLM 回复）
# 必须是一个公网可访问的 HTTP(S) 地址，推荐使用 HTTPS。
# 部署时填写你的服务器公网地址，例如:
#   CUSTOMLLM_CALLBACK_URL=https://your-domain.com/llm/callback
# 本地开发测试时填写内网穿透地址或留空，模板中 Url 会替换为空。
CUSTOMLLM_CALLBACK_URL=
